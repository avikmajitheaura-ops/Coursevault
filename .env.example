# CourseVault - copy this file to .env and fill in real values.
# Never commit .env or share it (it contains your bot token).

# Telegram Bot (token from @BotFather; your numeric Telegram user ID)
BOT_TOKEN=123456789:replace_with_your_real_token_from_botfather
OWNER_TELEGRAM_ID=123456789

# SQLite database file (created automatically)
SQLITE_DB_PATH=coursevault.db

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Not implemented yet
AI_ENABLED=false
FAMGATEWAY_ENABLED=false
